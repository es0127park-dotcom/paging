<!DOCTYPE html>
<html lang="ko">
<head>
    <meta charset="UTF-8">
    <title>커서 페이징</title>
    <style>
        body { font-family: "Segoe UI", sans-serif; margin: 40px; background: #f8fafc; color: #0f172a; }
        main { max-width: 880px; margin: 0 auto; }
        .panel { background: white; border-radius: 16px; padding: 24px; box-shadow: 0 10px 30px rgba(15, 23, 42, 0.08); }
        ul { padding-left: 20px; }
        button { margin-top: 16px; padding: 10px 16px; border: 0; border-radius: 10px; background: #2563eb; color: white; cursor: pointer; }
        code { background: #e2e8f0; padding: 2px 6px; border-radius: 6px; }
    </style>
</head>
<body>
<main>
    <h1>예제 (5) 커서 페이징</h1>
    <div class="panel">
        <p><code>OFFSET</code> 대신 마지막으로 본 게시글의 <code>id</code>를 다음 조회 기준으로 사용한다.</p>
        <p>API 주소: <code>/api/cursor/boards?cursor=마지막ID&size=10</code></p>

        <ul id="board-list"></ul>
        <button id="load-more" type="button">더보기</button>
    </div>

    <p><a href="/">홈으로</a></p>
</main>

<script>
    let nextCursor = null;
    let hasNext = true;

    async function loadBoards() {
        if (!hasNext) {
            document.getElementById('load-more').disabled = true;
            return;
        }

        const query = nextCursor === null ? '' : `?cursor=${nextCursor}`;
        const response = await fetch(`/api/cursor/boards${query}`);
        const data = await response.json();

        const list = document.getElementById('board-list');
        data.boards.forEach(board => {
            const item = document.createElement('li');
            item.textContent = `${board.id} / ${board.title}`;
            list.appendChild(item);
        });

        nextCursor = data.nextCursor;
        hasNext = data.hasNext;

        if (!hasNext) {
            const button = document.getElementById('load-more');
            button.disabled = true;
            button.textContent = '마지막 페이지';
        }
    }

    document.getElementById('load-more').addEventListener('click', loadBoards);
    loadBoards();
</script>
</body>
</html>
